# ============================================================
# Tonkla WordPress site overlay
# Tracks: custom theme + custom plugins + project docs/config
# Ignores: WordPress core, third-party plugins, runtime data
# Pull this repo into a WordPress root so paths stay aligned.
# ============================================================

# ------------------------------------------------------------
# WordPress core (install on the destination separately)
# ------------------------------------------------------------
/wp-admin/
/wp-includes/
/wp-*.php
/index.php
/license.txt
/readme.html
/xmlrpc.php
/wp-config-sample.php

# ------------------------------------------------------------
# Secrets / credentials / local env
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

wp-config.php
wp-config-local.php
wp-config.*.local.php

*.pem
*.key
*.p12
*.pfx
*.crt
auth.json
credentials.json
secrets.json
**/secrets/
**/private/

# Local ops docs (production git, Sonar, contacts — keep on server/dev, not in repo)
/docs/

# ------------------------------------------------------------
# wp-content: track only our theme + custom plugins
# ------------------------------------------------------------
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-content/backup*/
/wp-content/backups/
/wp-content/updraft/
/wp-content/ai1wm-backups/
/wp-content/aiowps_backups/
/wp-content/wflogs/
/wp-content/languages/
/wp-content/jetpack-waf/
/wp-content/wp-cloudflare-super-page-cache/
/wp-content/debug.log
/wp-content/*.log
/wp-content/advanced-cache.php
/wp-content/advanced-cache-backup.php
/wp-content/object-cache.php
/wp-content/db.php
/wp-content/index.php
/wp-content/*.php
!/wp-content/plugins/
!/wp-content/themes/

# Ignore all plugins, then allowlist custom ones
/wp-content/plugins/*
!/wp-content/plugins/index.php
!/wp-content/plugins/tonkla-warranty-tracker/
!/wp-content/plugins/tonkla-warranty-tracker/**
!/wp-content/plugins/tonkla-image-optimizer/
!/wp-content/plugins/tonkla-image-optimizer/**
!/wp-content/plugins/tonkla-database-cleaner/
!/wp-content/plugins/tonkla-database-cleaner/**

# Local Suite migration backups (never commit)
/_suite-backups/

# Ignore all themes, then allowlist Tonkla theme
/wp-content/themes/*
!/wp-content/themes/index.php
!/wp-content/themes/tonkla/
!/wp-content/themes/tonkla/**

# Re-ignore nested git / local junk after allowlist (order matters)
wp-content/themes/tonkla/.git/
wp-content/themes/tonkla/node_modules/
wp-content/themes/tonkla/_patch_*.py
wp-content/themes/tonkla/**/*.css.map
wp-content/themes/tonkla/**/*.js.map

# ------------------------------------------------------------
# SonarQube — keep examples, ignore local token scripts & reports
# ------------------------------------------------------------
sonarqube/scan.bat
sonarqube/export-sonar.bat
sonarqube/*.local.bat
sonar-reports/
.scannerwork/
.sonar/
*.sonar-token

# ------------------------------------------------------------
# Dependencies / build
# ------------------------------------------------------------
node_modules/
vendor/
# Self-hosted Font Awesome lives under theme assets/vendor (needed on production)
!wp-content/themes/tonkla/assets/vendor/
!wp-content/themes/tonkla/assets/vendor/**
# Composer deps for the theme stay local / installed on deploy
wp-content/themes/tonkla/vendor/
bower_components/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/
*.css.map
*.js.map

# ------------------------------------------------------------
# IDE / editor / AI local
# ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.history/
.agent/
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# ------------------------------------------------------------
# OS junk / logs / temp
# ------------------------------------------------------------
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.log
logs/
tmp/
temp/
*.tmp
*.temp
*.cache

# Local database dumps & archives
*.sql
*.sql.gz
*.sqlite
*.sqlite3
*.zip
*.tar
*.tar.gz
*.rar
*.7z

# ------------------------------------------------------------
# PHP / tooling local
# ------------------------------------------------------------
.phpunit.result.cache
.php-cs-fixer.cache
.phpcs-cache
coverage/
.phpunit.cache/

*.local
*.local.*
!*.local.example
!*.example
